    "Statistics use the latest comparable continuous segment within the last hour. Means describe recorded observations; unknown sensor timing is not upgraded to measured energy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistics use the latest comparable continuous segment within the last hour. Means describe recorded observations; unknown sensor timing is not upgraded to measured energy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика относится к последнему сопоставимому непрерывному участку за час. Средние описывают записанные наблюдения; неизвестное время датчика не превращается в измеренную энергию."
          }
        }
      }
    },
    "Raw allowlisted battery counters. Units, interval or blob layout may be unqualified; no W/Wh conversion is implied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw allowlisted battery counters. Units, interval or blob layout may be unqualified; no W/Wh conversion is implied."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные известные счётчики батареи. Единицы, интервал или формат данных могут быть не подтверждены; преобразование в W/Wh не выполнялось."
          }
        }
      }
    },
    "Scale inferred for the observed Mac17,3 / bq40z651 profile. Battery-reported lifetime history, not app history; independent sample age is unknown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scale inferred for the observed Mac17,3 / bq40z651 profile. Battery-reported lifetime history, not app history; independent sample age is unknown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштаб оценён для наблюдаемого профиля Mac17,3 / bq40z651. Это lifetime-данные контроллера батареи; независимый возраст измерений неизвестен."
          }
        }
      }
    },
    "No lifetime scale profile is admitted for this device. The original counter remains in raw diagnostics.": {
      "localizations": {

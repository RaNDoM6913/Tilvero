    "100% CPU means one full CPU. System processes can be inaccessible. Only verified app-bundle members are grouped; child rollups are not added.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% CPU means one full CPU. System processes can be inaccessible. Only verified app-bundle members are grouped; child rollups are not added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "100% CPU означает полную загрузку одного ядра. Системные процессы могут быть недоступны. Объединяются только подтверждённые процессы пакета приложения; суммарные счётчики дочерних процессов повторно не учитываются."
          }
        }
      }
    },

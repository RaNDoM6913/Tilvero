{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tilvero source-bound release manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "commit",
    "tag",
    "version",
    "build",
    "channel",
    "architecture",
    "minimumOS",
    "bundleID",
    "toolchain",
    "signingMode",
    "notarization",
    "downloadedInstall",
    "publicationReady",
    "assets",
    "mode",
    "teamID",
    "helperID",
    "guardianID"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
    },
    "version": {
      "type": "string"
    },
    "build": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "channel": {
      "enum": [
        "beta",
        "stable"
      ]
    },
    "architecture": {
      "const": "arm64"
    },
    "minimumOS": {
      "const": "26.0"
    },
    "mode": {
      "const": "monitoring"
    },
    "bundleID": {
      "const": "io.github.random6913.tilvero"
    },
    "helperID": {
      "type": "string"
    },
    "guardianID": {
      "type": "string"
    },
    "teamID": {
      "type": [
        "string",
        "null"
      ]
    },
    "toolchain": {
      "type": "string"
    },
    "signingMode": {
      "enum": [
        "adhoc",
        "developer-id"
      ]
    },
    "notarization": {
      "enum": [
        "not-requested",
        "accepted-stapled"
      ]
    },
    "downloadedInstall": {
      "enum": [
        "unverified",
        "accepted"
      ]
    },
    "publicationReady": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publicationReady": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "signingMode": {
            "const": "developer-id"
          },
          "notarization": {
            "const": "accepted-stapled"
          },
          "downloadedInstall": {
            "const": "accepted"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
